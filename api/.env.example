# Copy to .env for local runs. Without DB_HOST the API uses a local SQLite file.
API_KEY=change-me-to-a-long-random-key

# Azure MySQL (only reachable over the private endpoint / VPN)
# DB_HOST=kh-monitoring-db-xxxxx.mysql.database.azure.com
# DB_NAME=monitoring
# DB_USER=khadmin
# DB_PASSWORD=...

LOG_LEVEL=INFO
