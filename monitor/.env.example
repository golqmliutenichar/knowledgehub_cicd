# Copy this file to .env and fill in the values. Never commit .env.
METRICS=cpu,memory,disk
COUNT=1
INTERVAL=60

# An ALERT is printed when a value (in %) reaches its limit
CPU_LIMIT=90
MEMORY_LIMIT=90
DISK_LIMIT=85

# Monitoring API in Azure (private, reachable over the VPN)
API_URL=https://kh-monitoring-api.<environment-domain>.swedencentral.azurecontainerapps.io
API_KEY=
REQUEST_TIMEOUT=30

# Also check the health of the API and its database
CHECK_CLOUD=true

# Name this host reports under (default: the hostname)
# MONITOR_HOST=monitor
